---
import Icon from './Icon.astro';
import { url } from '../lib/url';

const links = [
  { href: url('/shop/'), label: 'Shop' },
  { href: url('/about/'), label: 'Our story' },
  { href: url('/blog/'), label: 'Journal' },
  { href: url('/contact/'), label: 'Contact' },
];

const current = Astro.url.pathname;
const isActive = (href: string) => current === href || current.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a class="logo" href={url('/')}>
      <Icon name="coffee" size={26} />
      <span>Northbank<small>Roasters</small></span>
    </a>

    <button class="toggle" aria-expanded="false" aria-controls="site-nav">
      <Icon name="menu" class="icon-open" />
      <Icon name="x" class="icon-close" />
      <span class="visually-hidden">Menu</span>
    </button>

    <nav id="site-nav" class="nav">
      {links.map((link) => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a class="btn nav-cta" href={url('/shop/')}>Order coffee</a>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle. Astro bundles this script once per page.
  const toggle = document.querySelector<HTMLButtonElement>('.toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('is-open', !open);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(250 246 241 / 92%);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72px;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ink);
    text-decoration: none;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1;
  }
  .logo :global(svg) { color: var(--accent); }
  .logo small {
    display: block;
    font-family: var(--sans);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .nav a:not(.btn) {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .nav a[aria-current='page'] { color: var(--accent); }
  .nav-cta { padding: 0.55rem 1.1rem; }
  .toggle {
    display: none;
    background: none;
    border: 0;
    color: var(--ink);
    padding: 0.5rem;
    cursor: pointer;
  }
  /* :global because the svg comes from the Icon component, outside this scope */
  .toggle :global(.icon-close) { display: none; }
  .toggle[aria-expanded='true'] :global(.icon-open) { display: none; }
  .toggle[aria-expanded='true'] :global(.icon-close) { display: block; }

  @media (max-width: 820px) {
    .toggle { display: block; }
    .nav {
      display: none;
      position: absolute;
      inset: 72px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem 1.25rem 1.25rem;
      background: var(--cream);
      border-bottom: 1px solid var(--line);
    }
    .nav.is-open { display: flex; }
    .nav a:not(.btn) { padding: 0.85rem 0; border-bottom: 1px solid var(--line); }
    .nav-cta { margin-top: 1rem; justify-content: center; }
  }
</style>
