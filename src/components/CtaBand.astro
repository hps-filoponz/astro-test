---
import Icon from './Icon.astro';
import { url } from '../lib/url';
---

<section class="cta">
  <div class="container inner">
    <div>
      <h2>Never run out of coffee</h2>
      <p>Get a fresh bag every 2, 3 or 4 weeks. Skip or pause any time. Save 10% on every delivery.</p>
    </div>
    <a class="btn btn--ghost" href={url('/shop/')}>
      Start a subscription <Icon name="arrow-right" size={18} />
    </a>
  </div>
</section>

<style>
  .cta { background: var(--accent); color: #fff; padding: 3.5rem 0; }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }
  h2 { margin-bottom: 0.3rem; }
  p { margin: 0; max-width: 36rem; opacity: 0.9; }
</style>
