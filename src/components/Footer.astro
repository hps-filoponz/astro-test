---
import Icon from './Icon.astro';
import { url } from '../lib/url';
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="brand"><Icon name="coffee" size={22} /> Northbank Roasters</p>
      <p class="muted">Small-batch coffee, roasted weekly and posted to your door.</p>
    </div>
    <div>
      <h3>Explore</h3>
      <ul>
        <li><a href={url('/shop/')}>Shop</a></li>
        <li><a href={url('/about/')}>Our story</a></li>
        <li><a href={url('/blog/')}>Journal</a></li>
        <li><a href={url('/contact/')}>Contact</a></li>
      </ul>
    </div>
    <div>
      <h3>Visit</h3>
      <ul class="icons">
        <li><Icon name="map-pin" size={18} /> Unit 4, Riverside Yard</li>
        <li><Icon name="clock" size={18} /> Sat 9am to 2pm</li>
        <li><Icon name="mail" size={18} /> hello@example.com</li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>
      A demo site built with Astro {Astro.generator.replace('Astro v', 'v')} for learning.
      Northbank Roasters is not a real business. Photos from
      <a href="https://unsplash.com/?utm_source=northbank_demo&utm_medium=referral">Unsplash</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: #c9bbb0;
    padding: 4rem 0 2rem;
    font-size: 0.95rem;
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1.3fr;
    gap: 2.5rem;
  }
  @media (max-width: 720px) { .cols { grid-template-columns: 1fr; } }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--serif);
    font-size: 1.3rem;
    color: #fff;
  }
  .brand :global(svg) { color: #e8a37f; }
  h3 {
    font-family: var(--sans);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
  }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .icons li { display: flex; align-items: center; gap: 0.6rem; }
  a { color: #c9bbb0; text-decoration: none; }
  a:hover { color: #fff; }
  .legal {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 12%);
    font-size: 0.85rem;
  }
  .legal a { text-decoration: underline; }
</style>
