---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' });
---

<Base title="Blog" description="All posts.">
  <h1>Blog</h1>
  {posts.map((post) => (
    <article>
      <h2><a href={url(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
      <p class="meta">{fmt.format(post.data.date)}</p>
      <p>{post.data.description}</p>
    </article>
  ))}
</Base>

<style>
  article { margin-bottom: 2rem; }
  h2 { margin-bottom: 0.2rem; font-size: 1.3rem; }
  .meta { color: var(--muted); font-size: 0.9rem; margin: 0; }
</style>
