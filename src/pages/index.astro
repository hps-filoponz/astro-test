---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductCard from '../components/ProductCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { brewGuides, features, hero, stats, story, unsplash } from '../data/site';
import { getCollection } from 'astro:content';

// Latest 4 coffees from WordPress
const coffees = (await getCollection('coffee'))
  .sort((a, b) => b.data.updated.localeCompare(a.data.updated))
  .slice(0, 4);
import { url } from '../lib/url';
---

<Base title="Home">
  <!-- Hero -->
  <section class="hero">
    <img
      class="hero-bg"
      src={unsplash(hero.image, 1800, 1100)}
      srcset={`${unsplash(hero.image, 900, 1100)} 900w, ${unsplash(hero.image, 1800, 1100)} 1800w`}
      sizes="100vw"
      alt={hero.alt}
      fetchpriority="high"
    />
    <div class="container hero-content">
      <span class="eyebrow">Roasted in small batches</span>
      <h1>Fresh coffee, roasted on Monday, at your door by Friday</h1>
      <p>
        Single origins and blends from farms we know by name. Roasted weekly in Essex and posted
        free on orders over £25.
      </p>
      <div class="actions">
        <a class="btn" href={url('/shop/')}>Shop coffee <Icon name="arrow-right" size={18} /></a>
        <a class="btn btn--ghost" href={url('/about/')}>Our story</a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="section section--white">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why Northbank</span>
        <h2>Better coffee starts before the cup</h2>
      </div>
      <div class="grid grid--4">
        {features.map((f) => (
          <div class="feature">
            <span class="feature-icon"><Icon name={f.icon} size={26} /></span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Products -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <div class="section-head">
          <span class="eyebrow">This week's roasts</span>
          <h2>Find your coffee</h2>
          <p>From bright and floral to deep and chocolatey. Every bag is 250g.</p>
        </div>
        <a class="link-arrow" href={url('/shop/')}>See all coffee <Icon name="arrow-right" size={18} /></a>
      </div>
      <div class="grid grid--4">
        {coffees.map((coffee) => <ProductCard coffee={coffee} />)}
      </div>
    </div>
  </section>

  <!-- Story split -->
  <section class="section section--white">
    <div class="container split">
      <div class="split-media">
        <img
          src={unsplash(story.image, 900, 1000)}
          width="900"
          height="1000"
          alt={story.alt}
          loading="lazy"
        />
      </div>
      <div>
        <span class="eyebrow">Our roastery</span>
        <h2>A 15kg roaster, two people and a lot of tasting</h2>
        <p>
          We started Northbank in a shared unit by the river. We still roast every batch by hand
          and taste every one before it goes in a bag.
        </p>
        <ul class="checks">
          <li><Icon name="check" size={20} /> Every batch logged and cupped</li>
          <li><Icon name="check" size={20} /> Green beans bought direct where we can</li>
          <li><Icon name="check" size={20} /> Roast date printed on every bag</li>
        </ul>
        <a class="btn" href={url('/about/')}>Read our story</a>
      </div>
    </div>
  </section>

  <!-- Stats -->
  <section class="section section--dark stats-band">
    <div class="container grid grid--4">
      {stats.map((s) => (
        <div class="stat">
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Brew guides -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Brew guides</span>
        <h2>Get the best from every bag</h2>
      </div>
      <div class="grid grid--2">
        {brewGuides.map((g) => (
          <article class="card guide">
            <img src={unsplash(g.image, 700, 700)} width="700" height="700" alt={g.alt} loading="lazy" />
            <div class="guide-body">
              <h3>{g.title}</h3>
              <div class="meta">
                <span><Icon name="timer" size={18} /> {g.time}</span>
                <span><Icon name="droplet" size={18} /> {g.ratio}</span>
              </div>
              <ol>
                {g.steps.map((step) => <li>{step}</li>)}
              </ol>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--white">
    <div class="container narrow">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2>Good to know</h2>
      </div>
      <Faq />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    position: relative;
    min-height: min(86vh, 760px);
    display: grid;
    align-items: end;
    color: #fff;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(20 14 10 / 25%) 0%, rgb(20 14 10 / 82%) 100%);
  }
  .hero-content { position: relative; z-index: 1; padding: 6rem 0 4.5rem; max-width: 46rem; margin-left: max(1.25rem, (100% - 1120px) / 2); }
  .hero .eyebrow { color: #f2b38f; }
  .hero p { font-size: 1.2rem; color: #efe6dd; max-width: 34rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.8rem; }

  .feature-icon {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 14px;
    background: #f7e6dc;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .feature p { color: var(--muted); margin: 0; }

  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 1rem; flex-wrap: wrap; }
  .link-arrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 2.5rem;
  }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }
  .split-media img { border-radius: var(--radius); aspect-ratio: 9 / 10; object-fit: cover; width: 100%; }
  .checks { list-style: none; padding: 0; margin: 1.5rem 0 2rem; display: grid; gap: 0.7rem; }
  .checks li { display: flex; gap: 0.7rem; align-items: center; font-weight: 500; }
  .checks :global(svg) { color: var(--accent); flex-shrink: 0; }

  .stats-band { padding: 3.5rem 0; }
  .stat { text-align: center; }
  .stat strong { display: block; font-family: var(--serif); font-size: 3rem; color: #fff; line-height: 1.1; }
  .stat span { color: #c9bbb0; }

  .guide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); }
  @media (max-width: 560px) { .guide { grid-template-columns: 1fr; } }
  .guide img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 1; }
  .guide-body { padding: 1.5rem; }
  .meta { display: flex; gap: 1.2rem; color: var(--muted); font-size: 0.9rem; margin-bottom: 1rem; }
  .meta span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .meta :global(svg) { color: var(--accent); }
  ol { padding-left: 1.2rem; margin: 0; display: grid; gap: 0.4rem; }
</style>
