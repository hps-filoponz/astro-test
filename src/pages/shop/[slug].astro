---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import CoffeeImage from '../../components/CoffeeImage.astro';
import { getCollection } from 'astro:content';
import { formatPrice } from '../../data/site';
import { url } from '../../lib/url';

// One page per coffee in WordPress
export async function getStaticPaths() {
  const coffees = await getCollection('coffee');
  return coffees.map((coffee) => ({
    params: { slug: coffee.id },
    props: { coffee, others: coffees.filter((c) => c.id !== coffee.id).slice(0, 3) },
  }));
}

const { coffee, others } = Astro.props;
const c = coffee.data;
const roastLevel = { Light: 1, Medium: 2, Dark: 3 }[c.roast];
const plain = c.description.replace(/<[^>]+>/g, '').trim();
const description = plain ? plain.slice(0, 155) : `${c.name}, a ${c.roast.toLowerCase()} roast coffee.`;
---

<Base title={c.name} description={description}>
  <section class="section">
    <div class="container">
      <a class="back" href={url('/shop/')}>
        <Icon name="arrow-right" size={18} class="flip" /> All coffee
      </a>

      <div class="product">
        <div class="media">
          {c.image ? (
            <CoffeeImage coffee={coffee} sizes="(max-width: 820px) 100vw, 560px" widths={[480, 800, 1120]} priority />
          ) : (
            <div class="placeholder"><Icon name="coffee" size={64} /></div>
          )}
        </div>

        <div class="info">
          {c.origin && <span class="eyebrow">{c.origin}</span>}
          <h1>{c.name}</h1>
          <p class="price">{formatPrice(c.price)} <small>/ 250g</small></p>

          <div class="facts">
            <div>
              <span class="label">Roast</span>
              <div class="roast" aria-label={`Roast level ${roastLevel} of 3`}>
                {[1, 2, 3].map((n) => <span class:list={{ on: n <= roastLevel }} />)}
                <strong>{c.roast}</strong>
              </div>
            </div>
            {c.notes.length > 0 && (
              <div>
                <span class="label">Tasting notes</span>
                <ul class="notes">
                  {c.notes.map((note) => <li>{note}</li>)}
                </ul>
              </div>
            )}
          </div>

          {/* HTML from the WordPress block editor */}
          <div class="description" set:html={c.description} />

          <div class="buy">
            <label>
              Grind
              <select>
                <option>Whole bean</option>
                <option>Espresso</option>
                <option>Filter</option>
                <option>Cafetière</option>
              </select>
            </label>
            <button class="btn" type="button">Add to basket <Icon name="plus" size={18} /></button>
          </div>

          <ul class="perks">
            <li><Icon name="flame" size={18} /> Roasted on Monday</li>
            <li><Icon name="truck" size={18} /> Free UK delivery over £25</li>
            <li><Icon name="package" size={18} /> Compostable bag</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {others.length > 0 && (
    <section class="section section--white">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Keep exploring</span>
          <h2>You might also like</h2>
        </div>
        <div class="grid grid--3">
          {others.map((o) => <ProductCard coffee={o} />)}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    text-decoration: none;
    margin-bottom: 2rem;
  }
  .back :global(.flip) { transform: rotate(180deg); }

  .product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 820px) { .product { grid-template-columns: minmax(0, 1fr); } }

  .media :global(img), .placeholder {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .placeholder { display: grid; place-items: center; background: var(--line); color: var(--accent); }

  h1 { margin-bottom: 0.3rem; }
  .price { font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; }
  .price small { font-size: 0.9rem; font-weight: 400; color: var(--muted); }

  .facts {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-block: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  .label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }
  .roast { display: flex; align-items: center; gap: 0.3rem; }
  .roast span { width: 32px; height: 7px; border-radius: 4px; background: var(--line); }
  .roast span.on { background: var(--accent); }
  .roast strong { margin-left: 0.6rem; }
  .notes { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .notes li {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
    font-size: 0.9rem;
  }

  .description { color: var(--muted); font-size: 1.05rem; }
  .description :global(p) { margin: 0 0 1em; }

  .buy { display: flex; flex-wrap: wrap; align-items: end; gap: 1rem; margin: 1.5rem 0; }
  .buy label { display: grid; gap: 0.35rem; font-weight: 600; font-size: 0.9rem; }
  .buy select {
    font: inherit;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--paper);
  }

  .perks { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; color: var(--muted); }
  .perks li { display: flex; align-items: center; gap: 0.6rem; }
  .perks :global(svg) { color: var(--accent); }
</style>
